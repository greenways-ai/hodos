{
  "name": "@greenways/hodos-renderer-playcanvas",
  "version": "0.1.0",
  "description": "PlayCanvas world, rigging, Mixamo, and character-sequence host add-on for Hodos",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/hodos.git",
    "directory": "packages/renderer-playcanvas"
  },
  "exports": {
    ".": "./src/index.js",
    "./renderer": "./src/world-renderer.js",
    "./advanced": "./src/advanced-world-renderer.js",
    "./enhancer": "./src/world-renderer-enhancer.js",
    "./sequence": "./src/sequence-host.js",
    "./mixamo": "./src/mixamo-character-host.js",
    "./rigging-assets": "./src/rigging-asset-host.js",
    "./rigging-preflight": "./src/rigging-glb-preflight.js",
    "./rigging-overlay": "./src/rigging-skeleton-overlay.js",
    "./rigging-authoring": "./src/rigging-authoring-renderer.js",
    "./rigging-handles": "./src/rigging-translate-handles.js",
    "./rigging-geometry": "./src/rigging-bind-geometry.js",
    "./rigging-binding": "./src/rigging-weight-artifacts.js",
    "./rigging-weight-editing": "./src/rigging-weight-editing.js",
    "./rigging-weight-heatmap": "./src/rigging-weight-heatmap.js",
    "./rigging-weight-painter": "./src/rigging-weight-painter.js",
    "./rigging-weight-selections": "./src/rigging-weight-selections.js",
    "./rigging-weight-task": "./src/rigging-weight-task.js",
    "./rigging-ik": "./src/rigging-ik-addon.js",
    "./styles": "./src/world-placement.css",
    "./rigging-surface": "./src/rigging-surface-index.js"
  },
  "files": [
    "src",
    "project.edn",
    "project.lock.edn",
    "hara.recipe.edn",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@greenways/hodos-core": "0.1.0",
    "@greenways/hodos-world-model": "0.1.0",
    "playcanvas": "2.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
