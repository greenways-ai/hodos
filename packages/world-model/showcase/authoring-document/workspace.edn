{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :showcase-hodos-world-model-authoring
 :workspace/revision 0
 :workspace/layout
 {:layout/type :split
  :layout/id :layout/root
  :layout/direction :horizontal
  :layout/ratio 0.2
  :layout/first {:layout/type :area :layout/area "area/project"}
  :layout/second
  {:layout/type :split
   :layout/id :layout/work
   :layout/direction :horizontal
   :layout/ratio 0.42
   :layout/first {:layout/type :area :layout/area "area/editor"}
   :layout/second
   {:layout/type :split
    :layout/id :layout/document-output
    :layout/direction :vertical
    :layout/ratio 0.76
    :layout/first {:layout/type :area :layout/area "area/document"}
    :layout/second {:layout/type :area :layout/area "area/output"}}}}
 :workspace/documents
 [{:document/id "document/source"
   :document/path "src/main.hal"
   :document/title "main.hal"
   :document/language :hal
   :document/dirty? false}
  {:document/id "document/model"
   :document/profile "hodos.rich-text/0-alpha"}]
 :workspace/areas
 [{:area/id "area/project"
   :area/type :project
   :area/title "Project"
   :area/presentation {:presentation/role :project :presentation/label "Files"}}
  {:area/id "area/editor"
   :area/type :code-editor
   :area/title "main.hal"
   :area/presentation {:presentation/role :editor :presentation/label "Code"}}
  {:area/id "area/output"
   :area/type :output
   :area/title "Preview"
   :area/presentation {:presentation/role :output :presentation/label "Canvas"}}
  {:area/id "area/document"
   :area/type "hodos.2d/document"
   :area/title "Authoring document"
   :area/presentation
   {:presentation/label "Model"
    :presentation/icon :document
    :presentation/surface :document
    :presentation/mode :document
    :presentation/order 2
    :presentation/compact true
    :presentation/auto-focus true}
   :area/component
   {:component/id "hodos.2d/document"
    :component/contract "workspace.component/0-alpha"
    :component/model
    {:document
     {:profile "hodos.rich-text/0-alpha"
      :id "document/model"
      :title "Authoring document"
      :revision 0
      :metadata {:source "showcase/states/authoring-normalized.edn"
                 :authority "package-showcase"}
      :children
      [{:id "block/title"
        :type "heading"
        :attrs {:level 1}
        :children [{:id "text/title" :type "text" :text "Authoring document"}]}
       {:id "block/summary"
        :type "paragraph"
        :attrs {}
        :children
        [{:id "text/summary"
          :type "text"
          :text "Three normalized entities, two collections, one prefab and one animation remain ordinary portable values."}]}
       {:id "block/selection"
        :type "hara-artefact"
        :attrs
        {:artefactId "artefact/selection"
         :kind "value"
         :title "Multi-selection"
         :mode "snapshot"
         :entry "showcase.hodos-world-model.authoring-document/selection"
         :capabilities []
         :snapshotRoot "sha256:hodos-world-model-selection"
         :snapshotDisplay "[cube-a cube-b]"
         :snapshotMediaType "application/edn"
         :snapshotSourceRoot "sha256:hodos-world-model-source"
         :metadata {:items 2 :pivot "median"}}
        :children [{:id "text/selection" :type "text" :text "selection"}]}
       {:id "block/transaction"
        :type "hara-artefact"
        :attrs
        {:artefactId "artefact/transaction"
         :kind "value"
         :title "Snapped transform"
         :mode "snapshot"
         :entry "showcase.hodos-world-model.authoring-document/transform"
         :capabilities []
         :snapshotRoot "sha256:hodos-world-model-transform"
         :snapshotDisplay "cube-a [1 0 0] · cube-b [3 0 0]"
         :snapshotMediaType "application/edn"
         :snapshotSourceRoot "sha256:hodos-world-model-source"
         :metadata {:event "world/editor-transform-selection" :snap 1}}
        :children [{:id "text/transaction" :type "text" :text "transform"}]}
       {:id "block/boundary"
        :type "blockquote"
        :attrs {}
        :children
        [{:id "text/boundary"
          :type "text"
          :text "No renderer, persistence provider, script executor or publication authority is selected by this value."}]}]}
     :selection {:nodeId "block/selection" :anchor nil :focus nil}
     :status "ready"
     :readOnly true
     :capabilities
     {:select true
      :editText false
      :insertBlock false
      :deleteBlock false
      :activateArtefact false
      :commitArtefact false
      :command false}
     :error nil}
    :component/events ["document/select"]}}]
 :workspace/nodes []
 :workspace/connections []
 :workspace/links
 [{:link/id "link/source-editor"
   :link/document "document/source"
   :link/area "area/editor"}
  {:link/id "link-model-document"
   :link/document "document/model"
   :link/area "area/document"}]
 :workspace/selection {:area/id "area/document" :document/id "document/model" :surface/id "document"}
 :workspace/customizations
 {:responsive/breakpoint 1000
  :responsive/default-surface "document"}
 :workspace/extensions []
 :workspace/pending []
 :workspace/audit []}
