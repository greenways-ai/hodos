{:component/id "hodos.dev/editor"
 :component/contract "workspace.component/0-alpha"
 :host {:kind "trusted-editor"
        :containerOwned true
        :updates "serializable-model"
        :dispose ["input-listeners" "completion-ui" "owned-dom"]}
 :events ["editor/input"
          "editor/selection"
          "editor/evaluate"
          "editor/save"]
 :authority {:source "application"
             :input-mechanics "host"
             :commands "hara-policy"}}
