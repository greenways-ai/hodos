{:hara/type :showcase
 :showcase/format 1
 :showcase/package :greenways/hodos-dev-ui
 :showcase/version "0.1.0"
 :showcase/title "Hodos Dev UI hosts"
 :showcase/summary
 "Trusted visible Explorer, Editor, Preview, REPL and Execution adapters driven by serializable Hodos Dev models."

 :showcase/views
 [{:view/id :explorer-host
   :view/title "Explorer host"
   :view/summary "A visible workspace-entry host with deterministic model updates and disposal."
   :view/source "src/index.js"
   :view/docs "README.md"}
  {:view/id :editor-host
   :view/title "Editor host"
   :view/summary "A trusted editor adapter that keeps source authority with Hara and the product."
   :view/source "src/index.js"
   :view/docs "README.md"}
  {:view/id :preview-host
   :view/title "Preview host"
   :view/summary "An injected preview service behind the Hodos Workspace component contract."
   :view/source "src/index.js"
   :view/docs "README.md"}
  {:view/id :repl-host
   :view/title "REPL host"
   :view/summary "A visible session console emitting only declared semantic events."
   :view/source "src/index.js"
   :view/docs "README.md"}
  {:view/id :execution-host
   :view/title "Execution host"
   :view/summary "A bounded evidence renderer emitting semantic execution and editor-selection requests."
   :view/source "src/index.js"
   :view/docs "README.md"}]

 :showcase/states
 [{:state/id :explorer-host/project
   :state/title "Explorer host lifecycle"
   :state/file "showcase/states/explorer-host.edn"}
  {:state/id :editor-host/live
   :state/title "Editor host lifecycle"
   :state/file "showcase/states/editor-host.edn"}
  {:state/id :preview-host/ready
   :state/title "Preview host lifecycle"
   :state/file "showcase/states/preview-host.edn"}
  {:state/id :repl-host/ready
   :state/title "REPL host lifecycle"
   :state/file "showcase/states/repl-host.edn"}
  {:state/id :execution-host/returned
   :state/title "Execution host lifecycle"
   :state/summary "Checked-in result-7 evidence, semantic controls, source selection and disposal."
   :state/file "showcase/states/execution-host.edn"}]

