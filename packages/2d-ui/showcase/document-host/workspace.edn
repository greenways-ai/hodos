{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :showcase-hodos-two-d-ui-document
 :workspace/revision 0
 :workspace/layout
 {:layout/type :split
  :layout/id :layout/root
  :layout/direction :horizontal
  :layout/ratio 0.34
  :layout/first {:layout/type :area :layout/area "area/editor"}
  :layout/second {:layout/type :area :layout/area "area/document"}}
 :workspace/documents
 [{:document/id "document/source"
   :document/path "src/main.hal"
   :document/title "main.hal"
   :document/language :hal
   :document/dirty? false}
  {:document/id "document/ui-host"
   :document/profile "hodos.rich-text/2"}]
 :workspace/areas
 [{:area/id "area/editor"
   :area/type :code-editor
   :area/title "main.hal"
   :area/presentation
   {:presentation/role :editor
    :presentation/label "Code"}}
  {:area/id "area/document"
   :area/type "hodos.2d/document"
   :area/title "Safe document host"
   :area/presentation
   {:presentation/label "Document"
    :presentation/icon :document
    :presentation/surface :document
    :presentation/mode :document
    :presentation/compact true
    :presentation/auto-focus true}
   :area/component
   {:component/id "hodos.2d/document"
    :component/contract "workspace.component/1"
    :component/model
    {:document
     {:profile "hodos.rich-text/2"
      :id "document/ui-host"
      :title "Safe document host"
      :revision 0
      :metadata {:source "showcase" :adapter "document-dom-host"}
      :children
      [{:id "block/title"
        :type "heading"
        :attrs {:level 1}
        :children [{:id "text/title" :type "text" :text "Safe document host"}]}
       {:id "block/intro"
        :type "paragraph"
        :attrs {}
        :children
        [{:id "text/intro"
          :type "text"
          :text "Edit this stable text node. Focus is restored after canonical updates."}]}
       {:id "block/boundary"
        :type "paragraph"
        :attrs {}
        :children
        [{:id "text/boundary"
          :type "text"
          :text "The host emits events; the application remains the state authority."}]}]}
     :selection {:nodeId "block/intro" :anchor nil :focus nil}
     :status "ready"
     :readOnly false
     :capabilities
     {:select true
      :editText true
      :insertBlock false
      :deleteBlock false
      :activateArtefact false
      :commitArtefact false
      :command false}
     :error nil}
    :component/events
    ["document/select"
     "document/edit-text"
     "document/insert-block"
     "document/delete-block"
     "document/activate-artefact"
     "document/commit-artefact"
     "document/command"]}}]
 :workspace/nodes []
 :workspace/connections []
 :workspace/links
 [{:link/id "link/source-editor"
   :link/document "document/source"
   :link/area "area/editor"}
  {:link/id "link/document-host"
   :link/document "document/ui-host"
   :link/area "area/document"}]
 :workspace/selection
 {:area/id "area/document"
  :document/id "document/ui-host"
  :surface/id "document"}
 :workspace/customizations
 {:responsive/breakpoint 900
  :responsive/default-surface "document"}
 :workspace/extensions []
 :workspace/pending []
 :workspace/audit []}
