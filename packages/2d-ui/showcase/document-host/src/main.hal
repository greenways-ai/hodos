(ns showcase.hodos-two-d-ui.document-host)

(def host
  {:kind :document-dom
   :safe-dom true
   :editable true
   :structural-mutation false})

(defn view []
  [:main {:class "preview-shell"}
   [:article {:class "card"}
    [:span {:class "eyebrow"} "GREENWAYS / HODOS 2D UI"]
    [:h1 "Safe document host"]
    [:p "Stable text focus and semantic editing without HTML injection."]]])

(view)
