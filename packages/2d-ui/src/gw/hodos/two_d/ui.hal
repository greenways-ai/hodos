(ns gw.hodos.two-d.ui)

(def document-component-id "hodos.2d/document")
(def graph-component-id "hodos.2d/graph")
(def component-contract "workspace.component/0-alpha")

(defn host-requirements [component-id]
  {:component/id component-id
   :component/contract component-contract
   :host/functions #{"update"}
   :host/lifecycle #{"dispose"}})
