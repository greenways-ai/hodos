(ns gw.hodos.session-draft
  (:require [gw.hodos.session :as base]))

(def ^:private *drafts* (atom {}))

(defn empty-history []
  {"undo" [] "redo" []})

(defn empty-editor []
  {"mode" "edit"
   "tool" "select"
   "space" "world"
   "selection" []
   "active" nil})

(defn normalize-editor [value]
  (let [editor (or value {})]
    {"mode" (if (= (get editor "mode") "preview") "preview" "edit")
     "tool" (or (get editor "tool") "select")
     "space" (if (= (get editor "space") "local") "local" "world")
     "selection" (or (get editor "selection") [])
     "active" (get editor "active")}))

(defn normalize-transform [value]
  (let [transform (or value {})]
    {"position" (or (get transform "position") [0 0 0])
     "rotation" (or (get transform "rotation") [0 0 0])
     "scale" (or (get transform "scale") [1 1 1])}))

(defn normalize-entity [entity]
  {"id" (get entity "id")
   "name" (or (get entity "name") (get entity "id"))
   "kind" (or (get entity "kind") "empty")
   "parent" (get entity "parent")
   "visible" (not (= (get entity "visible") false))
   "locked" (= (get entity "locked") true)
   "transform" (normalize-transform (get entity "transform"))
   "components" (or (get entity "components") {})})

(defn normalize-entities [entities]
  (base/map-vector (or entities []) normalize-entity))

(defn normalize-source [source]
  (assoc
   (assoc
    (assoc source
           "refDistance" (or (get source "refDistance") 1))
    "maxDistance" (or (get source "maxDistance") 30))
   "rolloffFactor" (or (get source "rolloffFactor") 1)))

(defn normalize-sources [sources]
  (base/map-vector (or sources []) normalize-source))

(defn normalize-draft [value]
  (let [draft (or value {})]
    {"format" "hodos-world-draft"
     "version" "0.1.0"
     "revision" (or (get draft "revision") 0)
     "dirty" false
     "audioSources" (normalize-sources (get draft "audioSources"))
     "entities" (normalize-entities (get draft "entities"))
     "editor" (normalize-editor (get draft "editor"))
     "history" (empty-history)}))

(defn initial-draft [world]
  (normalize-draft
   (or (get world "draft")
       {"audioSources" (or (get world "audioSources") [])
        "entities" (or (get world "entities") [])})))

(defn draft-value [session-id]
  (let [draft (get (deref *drafts*) session-id)]
    (if draft
      draft
      (throw (str "Unknown Hodos world draft: " session-id)))))

(defn store-draft [session-id draft]
  (do
    (swap! *drafts* (fn [drafts]
                      (assoc drafts session-id draft)))
    draft))

(defn draft-content [draft]
  {"audioSources" (or (get draft "audioSources") [])
   "entities" (or (get draft "entities") [])})

(defn draft-snapshot [draft]
  {"format" "hodos-world-draft"
   "version" "0.1.0"
   "revision" (or (get draft "revision") 0)
   "audioSources" (or (get draft "audioSources") [])
   "entities" (or (get draft "entities") [])})

(defn world-identity [state]
  (let [world (get state "world")
        project (get world "project")]
    {"repository" (get world "repository")
     "commit" (get world "commit")
     "project" {"id" (get project "id")
                "version" (get project "version")}}))

(defn merge-state [state draft]
  (let [world (get state "world")
        sources (or (get draft "audioSources") [])
        entities (or (get draft "entities") [])
        editor (normalize-editor (get draft "editor"))
        next-world (assoc
                    (assoc
                     (assoc
                      (assoc world "audioSources" sources)
                      "entities" entities)
                     "editor" editor)
                    "draft" draft)]
    (assoc
     (assoc state "world" next-world)
     "revision" (+ (or (get state "revision") 0)
                   (or (get draft "revision") 0)))))

(defn merge-result [result draft]
  (assoc result "state" (merge-state (get result "state") draft)))

(defn open [session-id world]
  (let [result (base/open session-id world)
        draft (store-draft session-id (initial-draft world))]
    (merge-result result draft)))

(defn get-session [session-id]
  (merge-result (base/get-session session-id)
                (draft-value session-id)))

(defn close [session-id]
  (do
    (swap! *drafts* (fn [drafts]
                      (dissoc drafts session-id)))
    (base/close session-id)))

(defn project-value [state]
  (get (get state "studio") "project"))

(defn scene-effects [draft]
  [{"effect" "scene"
    "method" "sync-world-entities"
    "args" [(or (get draft "entities") [])
            (normalize-editor (get draft "editor"))]}
   {"effect" "scene"
    "method" "sync-audio-sources"
    "args" [(or (get draft "audioSources") [])]}])

(defn draft-effects [state draft persist]
  (let [sources (or (get draft "audioSources") [])
        project (project-value state)
        effects (conj
                 (scene-effects draft)
                 {"effect" "audio"
                  "method" "sync-world-sources"
                  "args" [sources project]})]
    (if persist
      (conj effects
            {"effect" "storage"
             "method" "save-world-draft"
             "args" [(world-identity state) (draft-snapshot draft)]})
      effects)))

(defn editor-effects [draft]
  [{"effect" "scene"
    "method" "sync-world-entities"
    "args" [(or (get draft "entities") [])
            (normalize-editor (get draft "editor"))]}])

(defn world-response [session-id state draft persist]
  (let [next-draft (store-draft session-id draft)]
    {"state" (merge-state state next-draft)
     "effects" (draft-effects state next-draft persist)}))

(defn editor-response [session-id state editor]
  (let [draft (draft-value session-id)
        next-draft (store-draft session-id
                                (assoc draft "editor" (normalize-editor editor)))]
    {"state" (merge-state state next-draft)
     "effects" (editor-effects next-draft)}))

(defn draft-document-change [session-id state changed]
  (let [draft (draft-value session-id)
        history (or (get draft "history") (empty-history))
        next-history {"undo" (conj (or (get history "undo") [])
                                    (draft-content draft))
                      "redo" []}
        next-draft (assoc
                    (assoc
                     (assoc changed "history" next-history)
                     "dirty" true)
                    "revision" (+ 1 (or (get draft "revision") 0)))]
    (world-response session-id state next-draft true)))

(defn draft-change [session-id state sources]
  (draft-document-change
   session-id state
   (assoc (draft-value session-id) "audioSources" sources)))

(defn entity-change [session-id state entities editor]
  (draft-document-change
   session-id state
   (assoc
    (assoc (draft-value session-id) "entities" entities)
    "editor" (normalize-editor editor))))

(defn restore-draft [session-id state event]
  (let [input (get event "draft")]
    (if (not (= (get input "format") "hodos-world-draft"))
      (throw "Stored world draft has an unsupported format")
      (if (not (= (get input "version") "0.1.0"))
        (throw "Stored world draft has an unsupported version")
        (world-response session-id state (normalize-draft input) false)))))

(defn mark-draft-saved [session-id state event]
  (let [draft (draft-value session-id)
        revision (get event "revision")
        next-draft (if (= revision (get draft "revision"))
                     (assoc draft "dirty" false)
                     draft)]
    (store-draft session-id next-draft)
    {"state" (merge-state state next-draft)
     "effects" []}))

(defn export-draft [session-id state]
  (let [draft (draft-value session-id)]
    {"state" (merge-state state draft)
     "effects" [{"effect" "export"
                 "method" "world-draft"
                 "args" [(world-identity state) (draft-snapshot draft)]}]}))

(defn entity-present? [entities entity-id]
  (loop [index 0]
    (if (= index (count entities))
      false
      (if (= (get (nth entities index) "id") entity-id)
        true
        (recur (+ index 1))))))

(defn entity-value [entities entity-id]
  (loop [index 0]
    (if (= index (count entities))
      nil
      (let [entity (nth entities index)]
        (if (= (get entity "id") entity-id)
          entity
          (recur (+ index 1)))))))

(defn update-entity [entities entity-id update-fn]
  (base/map-vector
   entities
   (fn [entity]
     (if (= (get entity "id") entity-id)
       (update-fn entity)
       entity))))

(defn remove-entity [entities entity-id]
  (vec
   (filter
    (fn [entity]
      (not (= (get entity "id") entity-id)))
    (base/map-vector
     entities
     (fn [entity]
       (if (= (get entity "parent") entity-id)
         (assoc entity "parent" nil)
         entity))))))

(defn editor-select-target [editor target]
  (if target
    (assoc
     (assoc editor "selection" [target])
     "active" target)
    (assoc
     (assoc editor "selection" [])
     "active" nil)))

(defn editor-target-present? [draft target]
  (let [target-type (get target "type")
        target-id (get target "id")]
    (or (and (= target-type "entity")
             (entity-present? (or (get draft "entities") []) target-id))
        (and (= target-type "audio")
             (base/source-present? (or (get draft "audioSources") []) target-id)))))

(defn select-editor-target [session-id state event]
  (let [draft (draft-value session-id)
        target (get event "target")
        editor (normalize-editor (get draft "editor"))]
    (if (or (nil? target) (editor-target-present? draft target))
      (editor-response session-id state (editor-select-target editor target))
      (throw "Editor selection references an unknown world item"))))

(defn set-editor-tool [session-id state event]
  (let [tool (get event "tool")]
    (if (or (= tool "select")
            (= tool "translate")
            (= tool "rotate")
            (= tool "scale"))
      (editor-response
       session-id state
       (assoc (normalize-editor (get (draft-value session-id) "editor"))
              "tool" tool))
      (throw (str "Unsupported world editor tool: " tool)))))

(defn set-editor-mode [session-id state event]
  (let [mode (get event "mode")]
    (if (or (= mode "edit") (= mode "preview"))
      (editor-response
       session-id state
       (assoc (normalize-editor (get (draft-value session-id) "editor"))
              "mode" mode))
      (throw (str "Unsupported world editor mode: " mode)))))

(defn create-world-entity [session-id state event]
  (let [draft (draft-value session-id)
        entities (or (get draft "entities") [])
        entity (normalize-entity (get event "entity"))
        entity-id (get entity "id")
        parent-id (get entity "parent")
        editor (normalize-editor (get draft "editor"))
        target {"type" "entity" "id" entity-id}]
    (cond
      (nil? entity-id) (throw "World entity requires an id")
      (entity-present? entities entity-id)
      (throw (str "World entity id already exists: " entity-id))
      (and parent-id (not (entity-present? entities parent-id)))
      (throw (str "World entity parent does not exist: " parent-id))
      :else
      (entity-change
       session-id state
       (conj entities entity)
       (editor-select-target editor target)))))

(defn update-world-entity [session-id state event]
  (let [draft (draft-value session-id)
        entities (or (get draft "entities") [])
        entity (normalize-entity (get event "entity"))
        entity-id (get entity "id")
        parent-id (get entity "parent")]
    (cond
      (not (entity-present? entities entity-id))
      (throw (str "Unknown world entity: " entity-id))
      (= parent-id entity-id)
      (throw "World entity cannot parent itself")
      (and parent-id (not (entity-present? entities parent-id)))
      (throw (str "World entity parent does not exist: " parent-id))
      :else
      (entity-change
       session-id state
       (update-entity entities entity-id (fn [old] entity))
       (get draft "editor")))))

(defn transform-world-entity [session-id state event]
  (let [draft (draft-value session-id)
        entities (or (get draft "entities") [])
        entity-id (get event "entity")
        transform (normalize-transform (get event "transform"))]
    (if (entity-present? entities entity-id)
      (entity-change
       session-id state
       (update-entity
        entities entity-id
        (fn [entity]
          (if (= (get entity "locked") true)
            entity
            (assoc entity "transform" transform))))
       (get draft "editor"))
      (throw (str "Unknown world entity: " entity-id)))))

(defn delete-world-entity [session-id state event]
  (let [draft (draft-value session-id)
        entities (or (get draft "entities") [])
        entity-id (get event "entity")
        editor (normalize-editor (get draft "editor"))]
    (if (entity-present? entities entity-id)
      (entity-change
       session-id state
       (remove-entity entities entity-id)
       (editor-select-target editor nil))
      (throw (str "Unknown world entity: " entity-id)))))

(defn duplicate-world-entity [session-id state event]
  (let [draft (draft-value session-id)
        entities (or (get draft "entities") [])
        source-id (get event "source")
        entity (normalize-entity (get event "entity"))
        entity-id (get entity "id")
        editor (normalize-editor (get draft "editor"))]
    (cond
      (not (entity-present? entities source-id))
      (throw (str "Unknown world entity: " source-id))
      (entity-present? entities entity-id)
      (throw (str "World entity id already exists: " entity-id))
      :else
      (entity-change
       session-id state
       (conj entities entity)
       (editor-select-target editor {"type" "entity" "id" entity-id})))))

(defn place-world-audio [session-id state event]
  (let [payload (get event "payload")
        payload-type (get payload "type")
        source-id (get payload "id")
        track-id (get payload "track")
        clip-id (get payload "clip")
        project (project-value state)
        draft (draft-value session-id)
        sources (or (get draft "audioSources") [])
        actual-track (if (= payload-type "studio/clip")
                       (base/project-clip-track-id project clip-id)
                       track-id)]
    (cond
      (nil? source-id) (throw "World audio source requires an id")
      (base/source-present? sources source-id)
      (throw (str "World audio source id already exists: " source-id))
      (and (= payload-type "studio/track")
           (not (base/project-track-present? project track-id)))
      (throw (str "Unknown studio track: " track-id))
      (and (= payload-type "studio/clip")
           (nil? actual-track))
      (throw (str "Unknown studio clip: " clip-id))
      (not (or (= payload-type "studio/track")
               (= payload-type "studio/clip")))
      (throw (str "Unsupported world payload type: " payload-type))
      :else
      (let [source {"id" source-id
                    "kind" payload-type
                    "track" actual-track
                    "clip" (if (= payload-type "studio/clip") clip-id nil)
                    "label" (or (get payload "label") source-id)
                    "position" (or (get event "position") [0 0 0])
                    "playing" true
                    "loop" (not (= (get payload "loop") false))
                    "gainDb" (or (get payload "gainDb") 0)
                    "refDistance" (or (get payload "refDistance") 1)
                    "maxDistance" (or (get payload "maxDistance") 30)
                    "rolloffFactor" (or (get payload "rolloffFactor") 1)}
            editor (normalize-editor (get draft "editor"))
            changed (assoc
                     (assoc draft "audioSources" (conj sources source))
                     "editor" (editor-select-target
                               editor {"type" "audio" "id" source-id}))]
        (draft-document-change session-id state changed)))))

(defn update-world-source [session-id state event update-fn]
  (let [source-id (get event "source")
        draft (draft-value session-id)
        sources (or (get draft "audioSources") [])]
    (if (base/source-present? sources source-id)
      (draft-change session-id state
                    (base/update-source sources source-id update-fn))
      (throw (str "Unknown world audio source: " source-id)))))

(defn move-world-audio [session-id state event]
  (update-world-source
   session-id state event
   (fn [source]
     (assoc source "position" (or (get event "position")
                                  (get source "position"))))))

(defn gain-world-audio [session-id state event]
  (update-world-source
   session-id state event
   (fn [source]
     (assoc source "gainDb" (or (get event "gainDb")
                                (get source "gainDb"))))))

(defn range-world-audio [session-id state event]
  (update-world-source
   session-id state event
   (fn [source]
     (assoc
      (assoc
       (assoc source
              "refDistance" (or (get event "refDistance")
                                (get source "refDistance")))
       "maxDistance" (or (get event "maxDistance")
                         (get source "maxDistance")))
      "rolloffFactor" (or (get event "rolloffFactor")
                          (get source "rolloffFactor"))))))

(defn loop-world-audio [session-id state event]
  (update-world-source
   session-id state event
   (fn [source]
     (assoc source "loop" (get event "loop")))))

(defn toggle-world-audio [session-id state event]
  (update-world-source
   session-id state event
   (fn [source]
     (assoc source "playing" (not (get source "playing"))))))

(defn remove-world-audio [session-id state event]
  (let [source-id (get event "source")
        draft (draft-value session-id)
        sources (or (get draft "audioSources") [])
        editor (normalize-editor (get draft "editor"))
        active (get editor "active")
        next-editor (if (and active
                             (= (get active "type") "audio")
                             (= (get active "id") source-id))
                      (editor-select-target editor nil)
                      editor)]
    (if (base/source-present? sources source-id)
      (draft-document-change
       session-id state
       (assoc
        (assoc draft "audioSources"
               (vec (filter
                     (fn [source]
                       (not (= (get source "id") source-id)))
                     sources)))
        "editor" next-editor))
      (throw (str "Unknown world audio source: " source-id)))))

(defn clear-editor-selection [editor]
  (editor-select-target (normalize-editor editor) nil))

(defn restore-draft-content [draft content]
  (assoc
   (assoc
    (assoc draft "audioSources" (normalize-sources (get content "audioSources")))
    "entities" (normalize-entities (get content "entities")))
   "editor" (clear-editor-selection (get draft "editor"))))

(defn undo-world [session-id state]
  (let [draft (draft-value session-id)
        current (draft-content draft)
        history (or (get draft "history") (empty-history))
        undo (or (get history "undo") [])]
    (if (= (count undo) 0)
      {"state" (merge-state state draft) "effects" []}
      (let [previous (nth undo (- (count undo) 1))
            next-history {"undo" (base/without-last undo)
                          "redo" (conj (or (get history "redo") []) current)}
            next-draft (assoc
                        (assoc
                         (assoc
                          (restore-draft-content draft previous)
                          "history" next-history)
                         "dirty" true)
                        "revision" (+ 1 (or (get draft "revision") 0)))]
        (world-response session-id state next-draft true)))))

(defn redo-world [session-id state]
  (let [draft (draft-value session-id)
        current (draft-content draft)
        history (or (get draft "history") (empty-history))
        redo (or (get history "redo") [])]
    (if (= (count redo) 0)
      {"state" (merge-state state draft) "effects" []}
      (let [next-content (nth redo (- (count redo) 1))
            next-history {"undo" (conj (or (get history "undo") []) current)
                          "redo" (base/without-last redo)}
            next-draft (assoc
                        (assoc
                         (assoc
                          (restore-draft-content draft next-content)
                          "history" next-history)
                         "dirty" true)
                        "revision" (+ 1 (or (get draft "revision") 0)))]
        (world-response session-id state next-draft true)))))

(defn studio-project-event? [event-type]
  (or (= event-type "studio/import")
      (= event-type "studio/track-create")
      (= event-type "studio/restore")
      (= event-type "studio/clip-move")
      (= event-type "studio/clip-move-track")
      (= event-type "studio/clip-replace")
      (= event-type "studio/clip-split")
      (= event-type "studio/clip-insert-after")
      (= event-type "studio/clip-delete")
      (= event-type "studio/track-gain")
      (= event-type "studio/track-mute")
      (= event-type "studio/history-undo")
      (= event-type "studio/history-redo")))

(defn append-spatial-project-effect [result draft event-type]
  (let [sources (or (get draft "audioSources") [])]
    (if (and (studio-project-event? event-type)
             (> (count sources) 0))
      (assoc result "effects"
             (conj (or (get result "effects") [])
                   {"effect" "audio"
                    "method" "sync-world-sources"
                    "args" [sources (project-value (get result "state"))]}))
      result)))

(defn event [session-id input]
  (let [event-type (get input "event/type")
        state (get (base/get-session session-id) "state")]
    (cond
      (= event-type "world/drop")
      (place-world-audio session-id state input)

      (= event-type "world/editor-select")
      (select-editor-target session-id state input)

      (= event-type "world/editor-tool")
      (set-editor-tool session-id state input)

      (= event-type "world/editor-mode")
      (set-editor-mode session-id state input)

      (= event-type "world/entity-create")
      (create-world-entity session-id state input)

      (= event-type "world/entity-update")
      (update-world-entity session-id state input)

      (= event-type "world/entity-transform")
      (transform-world-entity session-id state input)

      (= event-type "world/entity-delete")
      (delete-world-entity session-id state input)

      (= event-type "world/entity-duplicate")
      (duplicate-world-entity session-id state input)

      (= event-type "world/audio-move")
      (move-world-audio session-id state input)

      (= event-type "world/audio-gain")
      (gain-world-audio session-id state input)

      (= event-type "world/audio-range")
      (range-world-audio session-id state input)

      (= event-type "world/audio-loop")
      (loop-world-audio session-id state input)

      (= event-type "world/audio-toggle")
      (toggle-world-audio session-id state input)

      (= event-type "world/audio-remove")
      (remove-world-audio session-id state input)

      (= event-type "world/history-undo")
      (undo-world session-id state)

      (= event-type "world/history-redo")
      (redo-world session-id state)

      (= event-type "world/draft-restore")
      (restore-draft session-id state input)

      (= event-type "world/draft-saved")
      (mark-draft-saved session-id state input)

      (= event-type "world/draft-export")
      (export-draft session-id state)

      :else
      (let [draft (draft-value session-id)
            result (base/event session-id input)
            updated (append-spatial-project-effect result draft event-type)]
        (merge-result updated draft)))))
