{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :showcase-hodos-addon-drafts-reversible
 :workspace/revision 0
 :workspace/layout
 {:layout/type :split
  :layout/id :layout/root
  :layout/direction :horizontal
  :layout/ratio 0.2
  :layout/first {:layout/type :area :layout/area "area/project"}
  :layout/second
  {:layout/type :split
   :layout/id :layout/work
   :layout/direction :horizontal
   :layout/ratio 0.38
   :layout/first {:layout/type :area :layout/area "area/editor"}
   :layout/second
   {:layout/type :split
    :layout/id :layout/graph-output
    :layout/direction :vertical
    :layout/ratio 0.76
    :layout/first {:layout/type :area :layout/area "area/graph"}
    :layout/second {:layout/type :area :layout/area "area/output"}}}}
 :workspace/documents
 [{:document/id "document/source"
   :document/path "src/main.hal"
   :document/title "main.hal"
   :document/language :hal
   :document/dirty? false}]
 :workspace/areas
 [{:area/id "area/project"
   :area/type :project
   :area/title "Project"
   :area/presentation {:presentation/role :project :presentation/label "Files"}}
  {:area/id "area/editor"
   :area/type :code-editor
   :area/title "main.hal"
   :area/presentation {:presentation/role :editor :presentation/label "Code"}}
  {:area/id "area/output"
   :area/type :output
   :area/title "Preview"
   :area/presentation {:presentation/role :output :presentation/label "Canvas"}}
  {:area/id "area/graph"
   :area/type "hodos.2d/graph"
   :area/title "Reversible draft"
   :area/presentation
   {:presentation/label "Draft"
    :presentation/icon :graph
    :presentation/surface :graph
    :presentation/mode :graph
    :presentation/order 3
    :presentation/compact true
    :presentation/auto-focus true}
   :area/component
   {:component/id "hodos.2d/graph"
    :component/contract "workspace.component/0-alpha"
    :component/model
    {:graph
     {:id "graph/draft-history"
      :revision 2
      :metadata {:title "Reversible draft" :source "showcase/states/reversible-transform.edn"}
      :nodes
      [{:id "node/open"
        :type "source"
        :label "Revision 0"
        :x 30 :y 170 :width 180 :height 112
        :ports [{:id "out/draft" :direction "out" :dataType "draft" :label "candidate"}]
        :metadata {:description "Exact world identity and initial content."}}
       {:id "node/transform"
        :type "transform"
        :label "Transform selection"
        :x 280 :y 80 :width 210 :height 126
        :ports
        [{:id "in/draft" :direction "in" :dataType "draft" :label "revision 0"}
         {:id "out/draft" :direction "out" :dataType "draft" :label "revision 1"}]
        :metadata {:description "Moves cube-a and cube-b in one transaction."}}
       {:id "node/effects"
        :type "effect-plan"
        :label "Closed effects"
        :x 560 :y 40 :width 190 :height 116
        :ports [{:id "in/draft" :direction "in" :dataType "draft" :label "revision 1"}]
        :metadata {:description "Scene sync and save intent; no provider is selected."}}
       {:id "node/undo"
        :type "transform"
        :label "Undo"
        :x 560 :y 270 :width 180 :height 112
        :ports
        [{:id "in/draft" :direction "in" :dataType "draft" :label "revision 1"}
         {:id "out/draft" :direction "out" :dataType "draft" :label "revision 2"}]
        :metadata {:description "Restores the exact prior content."}}
       {:id "node/restored"
        :type "result"
        :label "Restored positions"
        :x 820 :y 250 :width 210 :height 116
        :ports [{:id "in/draft" :direction "in" :dataType "draft" :label "revision 2"}]
        :metadata {:description "cube-a [0 0 0], cube-b [2 0 0]."}}]
      :connections
      [{:id "connection/open-transform"
        :from {:nodeId "node/open" :portId "out/draft"}
        :to {:nodeId "node/transform" :portId "in/draft"}}
       {:id "connection/transform-effects"
        :from {:nodeId "node/transform" :portId "out/draft"}
        :to {:nodeId "node/effects" :portId "in/draft"}}
       {:id "connection/transform-undo"
        :from {:nodeId "node/transform" :portId "out/draft"}
        :to {:nodeId "node/undo" :portId "in/draft"}}
       {:id "connection/undo-restored"
        :from {:nodeId "node/undo" :portId "out/draft"}
        :to {:nodeId "node/restored" :portId "in/draft"}}]}
     :selection {:nodeIds ["node/transform"] :connectionIds []}
     :viewport {:x 0 :y 0 :zoom 1}
     :status "ready"
     :readOnly true
     :capabilities
     {:select true
      :moveNode false
      :connect false
      :createNode false
      :delete false
      :command false}
     :error nil}
    :component/events ["graph/select"]}}]
 :workspace/nodes []
 :workspace/connections []
 :workspace/links
 [{:link/id "link/source-editor"
   :link/document "document/source"
   :link/area "area/editor"}]
 :workspace/selection {:area/id "area/graph" :surface/id "graph"}
 :workspace/customizations
 {:responsive/breakpoint 1000
  :responsive/default-surface "graph"}
 :workspace/extensions []
 :workspace/pending []
 :workspace/audit []}
