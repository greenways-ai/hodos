      :children
      [{:id "block/title"
        :type "heading"
        :attrs {:level 1}
        :children [{:id "text/title" :type "text" :text "Selected semantic review"}]}
       {:id "block/identity"
        :type "paragraph"
        :attrs {}
        :children
        [{:id "text/identity"
          :type "text"
          :text "greenways-worlds/room @ aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa · base revision 2"}]}
       {:id "block/proposal"
        :type "hara-artefact"
        :attrs
        {:artefactId "artefact/proposal"
         :kind "value"
         :title "Proposal proposal-1"
         :mode "snapshot"
         :entry "showcase.hodos-addon-publication.selected-review/review"
         :capabilities []
         :snapshotRoot "sha256:hodos-publication-proposal"
         :snapshotDisplay "3 changes · 2 selected · 1 excluded"
         :snapshotMediaType "application/edn"
         :snapshotSourceRoot "sha256:hodos-publication-source"
         :metadata {:baseRevision 2 :stale false}}
        :children [{:id "text/proposal" :type "text" :text "proposal"}]}
       {:id "block/selected"
        :type "paragraph"
        :attrs {}
        :children
        [{:id "text/selected"
          :type "text"
          :text "Selected: move cube-a; move and retune source-a. Excluded: add source-b."}]}
       {:id "block/intent"
        :type "hara-artefact"
        :attrs
        {:artefactId "artefact/intent"
         :kind "value"
         :title "Publication intents"
         :mode "snapshot"
         :entry "showcase.hodos-addon-publication.selected-review/review"
         :capabilities []
         :snapshotRoot "sha256:hodos-publication-intents"
         :snapshotDisplay "repository-patch · hestia-contribution"
         :snapshotMediaType "application/edn"
         :snapshotSourceRoot "sha256:hodos-publication-source"
         :metadata {:signed false :submitted false :persisted false}}
        :children [{:id "text/intent" :type "text" :text "publication intents"}]}
       {:id "block/boundary"
        :type "blockquote"
        :attrs {}
        :children
        [{:id "text/boundary"
          :type "text"
          :text "Signing, GitHub writes, Hestia admission and durable receipts remain host capabilities."}]}]}
     :selection {:nodeId "block/proposal" :anchor nil :focus nil}
