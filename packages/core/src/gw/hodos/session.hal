(ns gw.hodos.session)

(def ^:private *sessions* (atom {}))

(defn response [state effects]
  {"state" state
   "effects" (or effects [])})

(defn initial-studio []
  {"project" {"id" "local/current"
              "title" "Untitled project"
              "assets" []
              "tracks" []}
   "transport" {"status" "stopped"
                 "position" 0}
   "selection" {"tracks" []
                "clips" []}
   "history" {"undo" []
              "redo" []}})

(defn initial-session [session-id world]
  {"id" session-id
   "revision" 0
   "world" (assoc world "audioSources" (or (get world "audioSources") []))
   "surface" nil
   "studio" (initial-studio)})

(defn session-value [session-id]
  (let [session (get (deref *sessions*) session-id)]
    (if session
      session
      (throw (str "Unknown Hodos session: " session-id)))))

(defn store-session [session-id session]
  (do (swap! *sessions* (fn [sessions]
                          (assoc sessions session-id session)))
      session))

(defn next-revision [session]
  (assoc session "revision" (+ 1 (or (get session "revision") 0))))

(defn open [session-id world]
  (let [session (initial-session session-id world)]
    (response (store-session session-id session) [])))

(defn get-session [session-id]
  (response (session-value session-id) []))

(defn close [session-id]
  (do (swap! *sessions* (fn [sessions]
                          (dissoc sessions session-id)))
      (response {"id" session-id "status" "closed"} [])))

(defn activate-touchpoint [session event]
  (let [touchpoint (get event "touchpoint")
        surface-id (get touchpoint "surface")]
    (if surface-id
      (let [surface {"id" surface-id
                     "title" (or (get touchpoint "label") surface-id)
                     "presentation" (or (get touchpoint "presentation") "focus-overlay")
                     "touchpoint" (get touchpoint "id")
                     "camera" (get touchpoint "camera")
                     "config" (or (get touchpoint "config") {})}
            next (next-revision (assoc session "surface" surface))]
        {"session" next
         "effects" [{"effect" "ui"
                     "method" "open-surface"
                     "args" [surface]}]})
      (throw "Touchpoint does not declare a surface"))))

(defn close-surface [session]
  (let [surface (get session "surface")
        next (next-revision (assoc session "surface" nil))]
    {"session" next
     "effects" [{"effect" "ui"
                 "method" "close-surface"
                 "args" [(if surface (get surface "id") nil)]}]}))

(defn asset-present? [assets asset-id]
  (loop [index 0]
    (if (= index (count assets))
      false
      (if (= (get (nth assets index) "id") asset-id)
        true
        (recur (+ index 1))))))

(defn add-asset [assets asset]
  (if (asset-present? assets (get asset "id"))
    assets
    (conj assets asset)))

(defn map-vector [values update-fn]
  (loop [index 0 output []]
    (if (= index (count values))
      output
      (recur (+ index 1)
             (conj output (update-fn (nth values index)))))))

(defn append-vector [output values]
  (loop [index 0 next output]
    (if (= index (count values))
      next
      (recur (+ index 1) (conj next (nth values index))))))

(defn update-track [project track-id update-fn]
  (assoc project "tracks"
         (map-vector
          (or (get project "tracks") [])
          (fn [track]
            (if (= (get track "id") track-id)
              (update-fn track)
              track)))))

(defn project-track [project track-id]
  (let [tracks (or (get project "tracks") [])]
    (loop [index 0]
      (if (= index (count tracks))
        nil
        (let [track (nth tracks index)]
          (if (= (get track "id") track-id)
            track
            (recur (+ index 1))))))))

(defn project-track-present? [project track-id]
  (not (nil? (project-track project track-id))))

(defn update-track-clip [track clip-id update-fn]
  (assoc track "clips"
         (map-vector
          (or (get track "clips") [])
          (fn [clip]
            (if (= (get clip "id") clip-id)
              (update-fn clip)
              clip)))))

(defn update-clip [project clip-id update-fn]
  (assoc project "tracks"
         (map-vector
          (or (get project "tracks") [])
          (fn [track]
            (update-track-clip track clip-id update-fn)))))

(defn track-clip [track clip-id]
  (let [clips (or (get track "clips") [])]
    (loop [index 0]
      (if (= index (count clips))
        nil
        (let [clip (nth clips index)]
          (if (= (get clip "id") clip-id)
            clip
            (recur (+ index 1))))))))

(defn track-clip-present? [track clip-id]
  (not (nil? (track-clip track clip-id))))

(defn project-clip [project clip-id]
  (let [tracks (or (get project "tracks") [])]
    (loop [index 0]
      (if (= index (count tracks))
        nil
        (let [clip (track-clip (nth tracks index) clip-id)]
          (if clip
            clip
            (recur (+ index 1))))))))

(defn project-clip-track-id [project clip-id]
  (let [tracks (or (get project "tracks") [])]
    (loop [index 0]
      (if (= index (count tracks))
        nil
        (let [track (nth tracks index)]
          (if (track-clip-present? track clip-id)
            (get track "id")
            (recur (+ index 1))))))))

(defn project-clip-present? [project clip-id]
  (not (nil? (project-clip project clip-id))))

(defn rewrite-track-clips [track target rewrite-fn]
  (let [clips (or (get track "clips") [])]
    (assoc track "clips"
           (loop [index 0 output []]
             (if (= index (count clips))
               output
               (let [clip (nth clips index)]
                 (if (= (get clip "id") target)
                   (recur (+ index 1) (append-vector output (rewrite-fn clip)))
                   (recur (+ index 1) (conj output clip)))))))))

(defn rewrite-project-clips [project target rewrite-fn]
  (if (project-clip-present? project target)
    (assoc project "tracks"
           (map-vector
            (or (get project "tracks") [])
            (fn [track]
              (rewrite-track-clips track target rewrite-fn))))
    (throw (str "Unknown studio clip: " target))))

(defn source-present? [sources source-id]
  (loop [index 0]
    (if (= index (count sources))
      false
      (if (= (get (nth sources index) "id") source-id)
        true
        (recur (+ index 1))))))

(defn source-value [sources source-id]
  (loop [index 0]
    (if (= index (count sources))
      nil
      (let [source (nth sources index)]
        (if (= (get source "id") source-id)
          source
          (recur (+ index 1)))))))

(defn update-source [sources source-id update-fn]
  (map-vector
   sources
   (fn [source]
     (if (= (get source "id") source-id)
       (update-fn source)
       source))))

(defn without-last [values]
  (let [limit (- (count values) 1)]
    (loop [index 0 output []]
      (if (= index limit)
        output
        (recur (+ index 1) (conj output (nth values index)))))))

(defn world-audio-effects [sources project]
  [{"effect" "scene"
    "method" "sync-audio-sources"
    "args" [sources]}
   {"effect" "audio"
    "method" "sync-world-sources"
    "args" [sources project]}])

(defn project-response [session project history]
  (let [studio (get session "studio")
        next-studio (assoc (assoc studio "project" project) "history" history)
        next (next-revision (assoc session "studio" next-studio))
        transport (get next-studio "transport")
        sources (or (get (get session "world") "audioSources") [])
        transport-effects (if (= (get transport "status") "playing")
                            [{"effect" "audio"
                              "method" "apply-transport"
                              "args" [transport project]}]
                            [])
        spatial-effects (if (= (count sources) 0)
                          []
                          [{"effect" "audio"
                            "method" "sync-world-sources"
                            "args" [sources project]}])]
    {"session" next
     "effects" (append-vector transport-effects spatial-effects)}))

(defn project-change [session project]
  (let [studio (get session "studio")
        current (get studio "project")
        history (or (get studio "history") {"undo" [] "redo" []})
        next-history {"undo" (conj (or (get history "undo") []) current)
                      "redo" []}]
    (project-response session project next-history)))

(defn project-restore [session project]
  (project-response session project {"undo" [] "redo" []}))

(defn import-track [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        asset (get event "asset")
        track (get event "track")
        assets (or (get project "assets") [])
        tracks (or (get project "tracks") [])
        next-project (assoc
                      (assoc project "assets" (add-asset assets asset))
                      "tracks" (conj tracks track))]
    (if (project-track-present? project (get track "id"))
      (throw (str "Studio track id already exists: " (get track "id")))
      (project-change session next-project))))

(defn create-track [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        track (get event "track")
        track-id (get track "id")
        track-name (get track "name")]
    (cond
      (nil? track-id) (throw "Studio track requires an id")
      (nil? track-name) (throw "Studio track requires a name")
      (project-track-present? project track-id)
      (throw (str "Studio track id already exists: " track-id))
      :else
      (project-change
       session
       (assoc project "tracks"
              (conj (or (get project "tracks") [])
                    (assoc track "clips" (or (get track "clips") []))))))))

(defn restore-project [session event]
  (let [project (get event "project")]
    (if (get project "id")
      (project-restore session project)
      (throw "Restored studio project requires an id"))))

(defn move-clip [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        clip-id (get event "clip")
        start-seconds (or (get event "startSeconds") 0)
        next-project (update-clip
                      project clip-id
                      (fn [clip]
                        (assoc clip "startSeconds" start-seconds)))]
    (if (project-clip-present? project clip-id)
      (project-change session next-project)
      (throw (str "Unknown studio clip: " clip-id)))))

(defn move-clip-track [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        clip-id (get event "clip")
        track-id (get event "track")
        clip (project-clip project clip-id)
        start-seconds (or (get event "startSeconds") 0)]
    (cond
      (nil? clip) (throw (str "Unknown studio clip: " clip-id))
      (not (project-track-present? project track-id))
      (throw (str "Unknown studio track: " track-id))
      :else
      (let [moved (assoc clip "startSeconds" start-seconds)
            removed (rewrite-project-clips project clip-id (fn [old] []))
            next-project (update-track
                          removed track-id
                          (fn [track]
                            (assoc track "clips"
                                   (conj (or (get track "clips") []) moved))))]
        (project-change session next-project)))))

(defn replace-clip [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        clip (get event "clip")
        clip-id (get clip "id")
        next-project (rewrite-project-clips
                      project clip-id
                      (fn [old] [clip]))]
    (project-change session next-project)))

(defn split-clip [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        target (get event "target")
        left (get event "left")
        right (get event "right")]
    (if (not (= (get left "id") target))
      (throw "Left split clip must preserve the target id")
      (if (= (get right "id") target)
        (throw "Right split clip requires a new id")
        (if (project-clip-present? project (get right "id"))
          (throw (str "Studio clip id already exists: " (get right "id")))
          (project-change
           session
           (rewrite-project-clips project target (fn [old] [left right]))))))))

(defn insert-after-clip [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        target (get event "target")
        clip (get event "clip")
        clip-id (get clip "id")]
    (if (project-clip-present? project clip-id)
      (throw (str "Studio clip id already exists: " clip-id))
      (project-change
       session
       (rewrite-project-clips project target (fn [old] [old clip]))))))

(defn delete-clip [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        target (get event "clip")]
    (project-change
     session
     (rewrite-project-clips project target (fn [old] [])))))

(defn set-track-gain [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        track-id (get event "track")
        gain-db (get event "gainDb")
        next-project (update-track
                      project track-id
                      (fn [track]
                        (assoc track "gainDb" gain-db)))]
    (if (project-track-present? project track-id)
      (project-change session next-project)
      (throw (str "Unknown studio track: " track-id)))))

(defn set-track-mute [session event]
  (let [studio (get session "studio")
        project (get studio "project")
        track-id (get event "track")
        mute (get event "mute")
        next-project (update-track
                      project track-id
                      (fn [track]
                        (assoc track "mute" mute)))]
    (if (project-track-present? project track-id)
      (project-change session next-project)
      (throw (str "Unknown studio track: " track-id)))))

(defn place-world-audio [session event]
  (let [payload (get event "payload")
        payload-type (get payload "type")
        source-id (get payload "id")
        track-id (get payload "track")
        clip-id (get payload "clip")
        studio (get session "studio")
        project (get studio "project")
        world (get session "world")
        sources (or (get world "audioSources") [])
        actual-track (if (= payload-type "studio/clip")
                       (project-clip-track-id project clip-id)
                       track-id)]
    (cond
      (nil? source-id) (throw "World audio source requires an id")
      (source-present? sources source-id)
      (throw (str "World audio source id already exists: " source-id))
      (and (= payload-type "studio/track")
           (not (project-track-present? project track-id)))
      (throw (str "Unknown studio track: " track-id))
      (and (= payload-type "studio/clip")
           (nil? actual-track))
      (throw (str "Unknown studio clip: " clip-id))
      (not (or (= payload-type "studio/track")
               (= payload-type "studio/clip")))
      (throw (str "Unsupported world payload type: " payload-type))
      :else
      (let [source {"id" source-id
                    "kind" payload-type
                    "track" actual-track
                    "clip" (if (= payload-type "studio/clip") clip-id nil)
                    "label" (or (get payload "label") source-id)
                    "position" (or (get event "position") [0 0 0])
                    "playing" true
                    "loop" (not (= (get payload "loop") false))
                    "gainDb" (or (get payload "gainDb") 0)}
            next-sources (conj sources source)
            next-world (assoc world "audioSources" next-sources)
            next (next-revision (assoc session "world" next-world))]
        {"session" next
         "effects" (world-audio-effects next-sources project)}))))

(defn toggle-world-audio [session event]
  (let [source-id (get event "source")
        world (get session "world")
        sources (or (get world "audioSources") [])
        current (source-value sources source-id)
        project (get (get session "studio") "project")]
    (if current
      (let [next-sources (update-source
                          sources source-id
                          (fn [source]
                            (assoc source "playing" (not (get source "playing")))))
            next-world (assoc world "audioSources" next-sources)
            next (next-revision (assoc session "world" next-world))]
        {"session" next
         "effects" (world-audio-effects next-sources project)})
      (throw (str "Unknown world audio source: " source-id)))))

(defn remove-world-audio [session event]
  (let [source-id (get event "source")
        world (get session "world")
        sources (or (get world "audioSources") [])
        project (get (get session "studio") "project")]
    (if (source-present? sources source-id)
      (let [next-sources (vec (filter
                               (fn [source]
                                 (not (= (get source "id") source-id)))
                               sources))
            next-world (assoc world "audioSources" next-sources)
            next (next-revision (assoc session "world" next-world))]
        {"session" next
         "effects" (world-audio-effects next-sources project)})
      (throw (str "Unknown world audio source: " source-id)))))

(defn undo-project [session]
  (let [studio (get session "studio")
        current (get studio "project")
        history (or (get studio "history") {"undo" [] "redo" []})
        undo (or (get history "undo") [])]
    (if (= (count undo) 0)
      {"session" session "effects" []}
      (let [previous (nth undo (- (count undo) 1))
            next-history {"undo" (without-last undo)
                          "redo" (conj (or (get history "redo") []) current)}]
        (project-response session previous next-history)))))

(defn redo-project [session]
  (let [studio (get session "studio")
        current (get studio "project")
        history (or (get studio "history") {"undo" [] "redo" []})
        redo (or (get history "redo") [])]
    (if (= (count redo) 0)
      {"session" session "effects" []}
      (let [next-project (nth redo (- (count redo) 1))
            next-history {"undo" (conj (or (get history "undo") []) current)
                          "redo" (without-last redo)}]
        (project-response session next-project next-history)))))

(defn apply-transport [session event]
  (let [studio (get session "studio")
        transport (assoc (or (get studio "transport") {})
                         "status" (or (get event "status") "stopped"))
        next-studio (assoc studio "transport" transport)
        next (next-revision (assoc session "studio" next-studio))]
    {"session" next
     "effects" [{"effect" "audio"
                 "method" "apply-transport"
                 "args" [transport (get next-studio "project")]}]}))

(defn reduce-event [session event]
  (let [event-type (get event "event/type")]
    (cond
      (= event-type "touchpoint/activate") (activate-touchpoint session event)
      (= event-type "surface/close") (close-surface session)
      (= event-type "studio/import") (import-track session event)
      (= event-type "studio/track-create") (create-track session event)
      (= event-type "studio/restore") (restore-project session event)
      (= event-type "studio/clip-move") (move-clip session event)
      (= event-type "studio/clip-move-track") (move-clip-track session event)
      (= event-type "studio/clip-replace") (replace-clip session event)
      (= event-type "studio/clip-split") (split-clip session event)
      (= event-type "studio/clip-insert-after") (insert-after-clip session event)
      (= event-type "studio/clip-delete") (delete-clip session event)
      (= event-type "studio/track-gain") (set-track-gain session event)
      (= event-type "studio/track-mute") (set-track-mute session event)
      (= event-type "studio/history-undo") (undo-project session)
      (= event-type "studio/history-redo") (redo-project session)
      (= event-type "studio/transport") (apply-transport session event)
      (= event-type "world/drop") (place-world-audio session event)
      (= event-type "world/audio-toggle") (toggle-world-audio session event)
      (= event-type "world/audio-remove") (remove-world-audio session event)
      :else (throw (str "Unknown Hodos session event: " event-type)))))

(defn event [session-id input]
  (let [current (session-value session-id)
        output (reduce-event current input)
        next (get output "session")]
    (response (store-session session-id next)
              (get output "effects"))))
