{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :showcase-hodos-world-authoring-ui
 :workspace/revision 0
 :workspace/layout
 {:layout/type :split
  :layout/id :layout/root
  :layout/direction :horizontal
  :layout/ratio 0.18
  :layout/first {:layout/type :area :layout/area "area/project"}
  :layout/second
  {:layout/type :split
   :layout/id :layout/work
   :layout/direction :horizontal
   :layout/ratio 0.3
   :layout/first {:layout/type :area :layout/area "area/editor"}
   :layout/second {:layout/type :area :layout/area "area/world-authoring"}}}
 :workspace/documents
 [{:document/id "document/source"
   :document/path "src/main.hal"
   :document/title "main.hal"
   :document/language :hal
   :document/dirty? false}]
 :workspace/areas
 [{:area/id "area/project"
   :area/type :project
   :area/title "Project"
   :area/presentation {:presentation/role :project :presentation/label "Files"}}
  {:area/id "area/editor"
   :area/type :code-editor
   :area/title "main.hal"
   :area/presentation {:presentation/role :editor :presentation/label "Code"}}
  {:area/id "area/world-authoring"
   :area/type "hodos.world/authoring"
   :area/title "World Authoring"
   :area/presentation
   {:presentation/label "Authoring"
    :presentation/icon :world
    :presentation/surface :world-authoring
    :presentation/mode :world-authoring
    :presentation/order 2
    :presentation/compact true
    :presentation/auto-focus true}
   :area/component
   {:component/id "hodos.world/authoring"
    :component/contract "workspace.component/0-alpha"
    :component/model
    {:state
     {:world
      {:repository
       {:owner "greenways-worlds" :repo "editor"
        :url "https://github.com/greenways-worlds/editor"}
       :commit "cccccccccccccccccccccccccccccccccccccccc"
       :project {:id "greenways-worlds/editor" :version "1.0.0" :capabilities []}
       :draft
       {:format "hodos-world-draft"
        :version "0.1.0"
        :revision 4
        :dirty true
        :entities
        [{:id "cube-a" :name "North block" :kind "box" :parent nil :collection "set"
          :visible true :locked false :origin [0 0 0]
          :transform {:position [1 0 0] :rotation [0 15 0] :scale [1 1 1]}
          :components
          {:primitive {:shape "box" :color "#c8ad73" :opacity 1}
           :script
           {:language "hara" :enabled true :events ["world/editor-run"]
            :source "(fn [event entity world] {\"entity\" entity \"trace\" event})"}}}
         {:id "cube-b" :name "South block" :kind "box" :parent nil :collection "set"
          :visible true :locked false :origin [0 0 0]
          :transform {:position [3 0 0] :rotation [0 15 0] :scale [1 1 1]}
          :components {:primitive {:shape "box" :color "#719f87" :opacity 1}}}
         {:id "key-light" :name "Key light" :kind "point-light" :parent nil :collection "lighting"
          :visible true :locked false :origin [0 0 0]
          :transform {:position [0 4 2] :rotation [0 0 0] :scale [1 1 1]}
          :components {:light {:type "point" :color "#fff1ca" :intensity 1.5
                               :range 16 :castShadows true}}}]
        :audioSources
        [{:id "room-tone" :kind "studio/track" :track "ambience" :clip nil
          :label "Room tone" :position [0 1 -2] :playing false :loop true
          :gainDb -9 :refDistance 1 :maxDistance 30 :rolloffFactor 1}]
        :collections
        [{:id "set" :name "Set" :parent nil :visible true :locked false}
         {:id "lighting" :name "Lighting" :parent nil :visible true :locked false}]
        :assets
        [{:id "chair" :name "Chair" :kind "gltf"
          :url "https://assets.example.test/chair.glb" :thumbnail nil
          :metadata {:license "CC0"}}]
        :prefabs
        [{:id "pair" :name "Block pair" :description "Reusable pair"
          :rootIds ["cube-a" "cube-b"]
          :entities [{:id "cube-a"} {:id "cube-b"}]}]
        :animations
        [{:id "main" :name "Main" :duration 4 :fps 30
          :tracks
          [{:id "track-cube-a-position" :entity "cube-a" :property "position"
            :enabled true
            :keyframes
            [{:id "start" :time 0 :value [1 0 0] :easing "linear"}
             {:id "end" :time 4 :value [4 0 0] :easing "ease-in-out"}]}]}]
        :editor
        {:mode "edit" :tool "translate" :space "local" :pivot "median"
         :cursor [4 1 -2]
         :snap {:enabled true :translate 1 :rotate 15 :scale 0.25}
         :isolation nil :activeCollection "set"
         :selection [{:type "entity" :id "cube-a"} {:type "entity" :id "cube-b"}]
         :active {:type "entity" :id "cube-b"}
         :timeline {:animation "main" :time 1.5 :playing false :loop true}}
        :history {:undo [{:command "transform-selection" :revision 3}] :redo []}}
       :editor
       {:mode "edit" :tool "translate" :space "local" :pivot "median"
        :cursor [4 1 -2]
        :snap {:enabled true :translate 1 :rotate 15 :scale 0.25}
        :isolation nil :activeCollection "set"
        :selection [{:type "entity" :id "cube-a"} {:type "entity" :id "cube-b"}]
        :active {:type "entity" :id "cube-b"}
        :timeline {:animation "main" :time 1.5 :playing false :loop true}}
       :scripting {:traces []}
       :review {:proposal nil :selected [] :stale false :publications []}
       :publications []}}}
    :component/events
    ["world/document-commit"
     "world/editor-mode"
     "world/editor-select"
     "world/editor-tool"
     "world/editor-settings"
     "world/editor-transform-selection"
     "world/entity-create"
     "world/entity-update"
     "world/entity-transform"
     "world/entity-duplicate"
     "world/entity-delete"
     "world/audio-move"
     "world/audio-gain"
     "world/audio-range"
     "world/audio-loop"
     "world/audio-toggle"
     "world/audio-remove"
     "world/history-undo"
     "world/history-redo"
     "world/draft-export"
     "world/script-run"]}}]
 :workspace/nodes []
 :workspace/connections []
 :workspace/links
 [{:link/id "link/source-editor"
   :link/document "document/source"
   :link/area "area/editor"}]
 :workspace/selection {:area/id "area/world-authoring" :surface/id "world-authoring"}
 :workspace/customizations
 {:responsive/breakpoint 1040
  :responsive/default-surface "world-authoring"}
 :workspace/extensions []
 :workspace/pending []
 :workspace/audit []}
