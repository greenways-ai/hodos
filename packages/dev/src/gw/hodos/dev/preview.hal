(ns gw.hodos.dev.preview)

(def component-id "hodos.dev/preview")
(def component-contract "hodos.component/1")

(defn area
  ([id model]
   (area id "Preview" model))
  ([id title model]
   {:area/id id
    :area/type :hodos.dev/preview
    :area/title title
    :area/component
    {:component/id component-id
     :component/contract component-contract
     :component/model model
     :component/events #{"preview/open-source" "preview/retry"}}}))
